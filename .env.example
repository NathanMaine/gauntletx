# Copy to .env and adjust. .env is gitignored.
#
# There are no secrets in this file — gauntletx talks to a local vLLM on your
# own network, which needs no API key. Every value below has a working
# default baked into gauntletx.py, so an empty .env is a valid .env.

# The vLLM endpoint (OpenAI-compatible chat completions) on the Spark.
GAUNTLETX_VLLM_URL=http://127.0.0.1:8000/v1/chat/completions

# Which model to request. Leave this unset and gauntletx asks the sibling
# /v1/models endpoint at first use and takes whatever is loaded — vLLM serves
# one model at a time, so that is almost always the right answer. Set it only
# to pin a name; a stale pin fails on 404 and triggers re-discovery.
# Currently serving:
#GAUNTLETX_MODEL=sakamakismile/KAT-Coder-V2.5-Dev-NVFP4

# Sampling. 0.7 gives the bar-picking some imagination without wandering;
# 8192 tokens is room for reasoning plus all four output sections.
GAUNTLETX_TEMPERATURE=0.7
GAUNTLETX_MAX_TOKENS=8192

# Seconds to wait on a single vLLM call. Reasoning models think before they
# answer — 600 is generous on purpose.
GAUNTLETX_TIMEOUT=600

# Only needed if the vLLM ever sits behind an authenticating proxy — sent as
# "Authorization: Bearer <key>" when set; unset, no header is sent.
#GAUNTLETX_API_KEY=
