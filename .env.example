# Copy to .env and adjust. .env is gitignored.
#
# There are no secrets in this file — gauntletx talks to a local vLLM on your
# own network, which needs no API key. Every value below has a working
# default baked into gauntletx.py, so an empty .env is a valid .env.

# The vLLM endpoint (OpenAI-compatible chat completions). Point this at
# whichever box serves your model; the default assumes it is this one.
GAUNTLETX_VLLM_URL=http://127.0.0.1:8000/v1/chat/completions

# Which model to request. Leave this unset and gauntletx asks the sibling
# /v1/models endpoint at first use and takes whatever is loaded — vLLM serves
# one model at a time, so that is almost always the right answer. Set it only
# to pin a name; a stale pin fails on 404 and triggers re-discovery.
# Example:
#GAUNTLETX_MODEL=sakamakismile/KAT-Coder-V2.5-Dev-NVFP4

# Sampling. 0.7 gives the bar-picking some imagination without wandering.
#
# 8192 was wrong and failed silently. Measured on Qwen3.8-27B with this system
# prompt: ~13.4k tokens of thinking before the first word of the answer, ~15k
# to finish. At 8192 every complex goal came back as "the model returned no
# output" after six minutes — the whole budget spent thinking, nothing left to
# say it with. 32768 leaves headroom for a harder goal.
GAUNTLETX_TEMPERATURE=0.7
GAUNTLETX_MAX_TOKENS=32768

# Seconds to wait on a single vLLM call. Raised with max_tokens and for the
# same reason: the 15k-token run took 657 seconds, so the old 600 turned a
# working generation into a timeout.
GAUNTLETX_TIMEOUT=1800

# Thinking, tri-state. Unset (the default) sends nothing and lets the model's
# own chat template decide. "false" answers the same brief in ~600 tokens
# instead of ~15000 — roughly 13x cheaper and 24x faster, at the cost of the
# model working the problem out loud first. Per-browser override lives in the
# Config panel; this is the box-wide default.
#GAUNTLETX_ENABLE_THINKING=false

# Only needed if the endpoint above sits behind an authenticating proxy — sent
# as "Authorization: Bearer <key>" when set; unset, no header is sent. This one
# is scoped to GAUNTLETX_VLLM_URL's host and travels nowhere else.
#GAUNTLETX_API_KEY=

# ---------------------------------------------------------------- providers
#
# gauntletx can also point at a hosted OpenAI-compatible endpoint. Pick the
# provider in the Config panel (on either tab) and it fills the URL for you;
# set the matching key here and nobody has to paste one into a browser.
#
# Each key is bound to ITS OWN provider's host. Overriding the endpoint to some
# other address does NOT drag a stored key along — otherwise pointing gauntletx
# at a box you don't control would post your secret to it. A custom endpoint
# can still authenticate, using a key supplied in the Config panel.
#
# Leave these unset and nothing changes: the Config panel accepts a key
# per-browser instead, which is the quickest way to try one on a trusted LAN.
#GAUNTLETX_OPENROUTER_API_KEY=
#GAUNTLETX_DEEPSEEK_API_KEY=
#GAUNTLETX_QWEN_API_KEY=
